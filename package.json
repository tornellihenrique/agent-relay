{
  "name": "agent-relay",
  "version": "0.1.0",
  "description": "Run AI agents (Claude Code and others) as chat bots: one bot per folder context, with live feedback, persistent memory and a supervisor that starts with your machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "relay": "bin/relay.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@anthropic-ai/sdk": "^0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
